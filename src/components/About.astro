---
import AboutPhotoTransition from './AboutPhotoTransition.jsx';
---

<section class="max-w-[1060px] mb-[120px] md:mb-[240px]" aria-labelledby="about-title">
  <div class="flex items-center gap-[10px] md:gap-[14px] mb-[32px] md:mb-[60px]">
    <span class="inline-flex items-center justify-center w-[26px] h-[26px] md:w-[32px] md:h-[32px]" aria-hidden="true">
      <svg class="w-[24px] h-[24px] md:w-[30px] md:h-[30px] stroke-[var(--color-text)] stroke-2 fill-none stroke-[2.1px]" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
        <path d="M4 21a8 8 0 0 1 16 0" />
      </svg>
    </span>
    <h2 class="m-0 text-[1.6rem] md:text-[clamp(2rem,4vw,3.3rem)] font-extrabold leading-none" id="about-title">Sobre mí</h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.18fr)_minmax(280px,0.72fr)] gap-[32px] md:gap-[clamp(36px,6vw,72px)] items-start">
    <div class="grid gap-[18px] md:gap-[22px]">
      <p class="m-0 text-[rgba(247,244,238,0.82)] text-[0.95rem] md:text-[clamp(1rem,1.45vw,1.18rem)] font-medium leading-[1.6] md:leading-[1.62]">
        Soy estudiante de déimo ciclo de
        <strong class="text-[var(--color-text)] font-[820]">Ingeniería de Sistemas Computacionales</strong>, con interés en
        el desarrollo de software, la automatización de procesos y la ciencia de
        datos. Me gusta crear soluciones tecnológicas que no solo funcionen
        bien, sino que también ayuden a resolver problemas reales y mejorar la
        gestión de la información.
      </p>

      <p class="m-0 text-[rgba(247,244,238,0.82)] text-[0.95rem] md:text-[clamp(1rem,1.45vw,1.18rem)] font-medium leading-[1.6] md:leading-[1.62]">
        He desarrollado aplicaciones web y móviles, sistemas internos,
        dashboards y proyectos basados en datos, utilizando tecnologías como
        <strong class="text-[var(--color-text)] font-[820]">React, Astro, Flask, Kotlin, Firebase, MySQL, PostgreSQL y Power BI</strong>.
        Además, me considero una persona con capacidad de aprendizaje autónomo,
        organizada y orientada a resultados, especialmente en entornos donde se
        requiere trabajo en equipo y adaptación constante.
      </p>

      <p class="m-0 text-[rgba(247,244,238,0.82)] text-[0.95rem] md:text-[clamp(1rem,1.45vw,1.18rem)] font-medium leading-[1.6] md:leading-[1.62]">
        Actualmente sigo fortaleciendo mis habilidades en desarrollo fullstack,
        análisis de datos, cloud y automatización, con el objetivo de construir
        soluciones útiles, escalables y bien estructuradas.
      </p>
    </div>

    <div class="relative p-[10px] md:p-[14px] border border-[rgba(247,244,238,0.12)] rounded-[10px] md:rounded-[12px] bg-[linear-gradient(135deg,rgba(255,255,255,0.08),transparent_42%),rgba(247,244,238,0.035)] before:absolute before:inset-[auto_18px_18px_auto] before:w-[120px] before:h-[120px] before:rounded-full before:bg-[rgba(255,61,18,0.22)] before:blur-[44px]">
      <div class="relative grid min-h-[280px] md:min-h-[420px] place-items-center overflow-hidden border border-[rgba(247,244,238,0.1)] rounded-[6px] md:rounded-[8px] bg-[radial-gradient(circle_at_50%_22%,rgba(255,61,18,0.22),transparent_34%),radial-gradient(rgba(247,244,238,0.22)_1px,transparent_1px),#0d0d0d] bg-[length:auto,12px_12px,auto]">
        <AboutPhotoTransition client:visible />
        
      </div>
      <div class="relative flex items-center p-[10px_4px_2px] md:p-[14px_4px_2px] font-mono text-[0.7rem] md:text-[0.74rem] uppercase">
        <span class="text-[var(--color-text)] font-[850]">Ingeniero de Sistemas</span>
      </div>
    </div>
  </div>
</section>
