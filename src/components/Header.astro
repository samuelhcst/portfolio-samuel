---
const navItems = [
  { label: 'Experiencia', href: '#experiencia' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Tecnologías', href: '#stack' },
  { label: 'Sobre mi', href: '#sobre-mi' },
];
---

<header class="sticky top-0 z-20 grid grid-cols-[1fr_auto] md:grid-cols-[1fr_auto_1fr] items-center w-full min-h-[var(--header-height)] px-[clamp(16px,3vw,32px)] border-b border-[var(--color-line)] bg-[rgba(7,7,7,0.76)] backdrop-blur-[18px] backdrop-saturate-[140%] transition-all duration-180 ease-out [&.is-past-hero]:relative [&.is-past-hero]:opacity-0 [&.is-past-hero]:invisible [&.is-past-hero]:pointer-events-none [&.is-past-hero]:-translate-y-full" data-site-header>

  <nav class="hidden md:flex col-start-2 justify-self-center items-center justify-center gap-[clamp(16px,2.4vw,34px)] font-mono text-[0.75rem] font-bold uppercase [&>a]:transition-colors [&>a]:duration-180 [&>a]:ease-out hover:[&>a]:text-[var(--color-accent)]" aria-label="Navegacion principal">
    {
      navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
  </nav>

  <div class="hidden md:flex col-start-3 justify-self-end items-center gap-[12px]">
    <a 
    class="inline-flex items-center justify-center min-h-[38px] px-[16px] border border-[rgba(247,244,238,0.34)] rounded-full font-mono text-[0.72rem] font-extrabold uppercase transition-all duration-180 ease-out hover:text-[var(--color-accent)]" 
    href="https://drive.google.com/file/d/1IQGp38TZ7mjA1Cyh1nz5KKnx3nnBViVB/view?usp=sharing" 
    target="_blank" 
    rel="noreferrer"
    aria-label="Ver CV de Samuel Huaccha">
      CV
    </a>
    <a class="inline-flex items-center justify-center min-h-[38px] px-[16px] text-[#100804] border border-[var(--color-accent)] bg-[var(--color-accent)] rounded-full font-mono text-[0.72rem] font-extrabold uppercase transition-all duration-180 ease-out hover:bg-[var(--color-bg-soft)] hover:text-[var(--color-text)] hover:border-[var(--color-dot)]" href="#contacto">
      Contacto
    </a>
  </div>

  <button
    class="md:hidden col-start-2 justify-self-end block w-[42px] h-[38px] p-0 border border-[rgba(247,244,238,0.24)] rounded-full bg-[rgba(247,244,238,0.04)] cursor-pointer transition-all duration-180 ease-out [&[aria-expanded=true]]:text-[#100804] [&[aria-expanded=true]]:border-[var(--color-accent)] [&[aria-expanded=true]]:bg-[var(--color-accent)] group"
    type="button"
    aria-label="Abrir menu de navegacion"
    aria-expanded="false"
    aria-controls="mobile-menu"
    data-menu-toggle
  >
    <span class="block w-[16px] h-[1px] mx-auto bg-[var(--color-text)] transition-colors duration-180 group-aria-expanded:bg-[#100804]" aria-hidden="true"></span>
    <span class="block w-[16px] h-[1px] mx-auto bg-[var(--color-text)] mt-[6px] transition-colors duration-180 group-aria-expanded:bg-[#100804]" aria-hidden="true"></span>
  </button>

  <nav id="mobile-menu" class="absolute top-[calc(100%+1px)] right-[16px] left-[16px] grid gap-[4px] p-[14px] border border-[var(--color-line)] bg-[rgba(10,10,10,0.96)] backdrop-blur-[18px] [&[hidden]]:hidden [&>a]:p-[12px] [&>a]:font-mono [&>a]:text-[0.78rem] [&>a]:font-extrabold [&>a]:uppercase [&>a]:transition-colors [&>a]:duration-180 hover:[&>a]:text-[var(--color-accent)]" aria-label="Navegacion movil" data-mobile-menu hidden>
    {
      navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
    <a href="/cv.pdf" aria-label="Ver CV de Samuel Huaccha">CV</a>
    <a class="text-[#100804] bg-[var(--color-accent)] hover:!text-[#100804] hover:opacity-90" href="#contacto">Contacto</a>
  </nav>
</header>

<script>
  const menuToggle = document.querySelector('[data-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');
  const siteHeader = document.querySelector('[data-site-header]');
  const heroSection = document.querySelector('#inicio');

  if (menuToggle instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement) {
    const closeMenu = () => {
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', 'Abrir menu de navegacion');
      mobileMenu.hidden = true;
    };

    menuToggle.addEventListener('click', () => {
      const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';

      menuToggle.setAttribute('aria-expanded', String(!isExpanded));
      menuToggle.setAttribute(
        'aria-label',
        isExpanded ? 'Abrir menu de navegacion' : 'Cerrar menu de navegacion',
      );
      mobileMenu.hidden = isExpanded;
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMenu);
    });
  }

  if (siteHeader instanceof HTMLElement && heroSection instanceof HTMLElement) {
    const setHeaderMode = () => {
      const heroBottom = heroSection.getBoundingClientRect().bottom;
      const headerHeight = siteHeader.offsetHeight;
      const isPastHero = heroBottom <= headerHeight;

      siteHeader.classList.toggle('is-past-hero', isPastHero);
    };

    setHeaderMode();
    window.addEventListener('scroll', setHeaderMode, { passive: true });
    window.addEventListener('resize', setHeaderMode);
  }
</script>
