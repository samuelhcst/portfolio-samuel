---
const projects = [
  {
    title: 'Aplicación móvil para el control de asistencia y calificaciones',
    description:
      'Aplicación móvil para docentes que automatiza el control de asistencia, gestión de calificaciones, generación de reportes y visualización de estadísticas académicas en tiempo real.',
    tags: ['Android', 'Kotlin', 'Jetpack Compose', 'Firebase'],
    codeUrl: '#',
    previewUrl: '#',
    img: '/images/projects/project-1.webp',
  },
  {
    title: 'Sistema web para la predicción de Diabetes Mellitus Tipo 2',
    description:
      'Plataforma web basada en Machine Learning que permite estimar el riesgo de diabetes tipo 2 a partir de parámetros clínicos. El sistema integra un modelo Random Forest, dashboards interactivos, visualización de tendencias y funcionalidades para el análisis de predicciones, ofreciendo una experiencia clara para la interpretación de resultados.',
    tags: ['React', 'Flask', 'Tailwind CSS', 'scikit-learn', 'PostgreSQL'],
    codeUrl: '#',
    previewUrl: '#',
    img: '/images/projects/project-2.webp',
  },
  {
    title: 'Aplicación móvil para la reserva de habitaciones en Hotel Boulevard',
    description:
      'Aplicación móvil diseñada para modernizar el proceso de reserva de habitaciones de un hotel. Permite a los usuarios consultar disponibilidad, registrar sus datos y confirmar reservas de manera rápida, manteniendo la información centralizada mediante autenticación y sincronización en la nube.',
    tags: ['Kotlin', 'Android', 'Firebase'],
    codeUrl: '#',
    previewUrl: '#',
    img: '/images/projects/project-3.webp',
  },
  {
    title: 'Web para la venta de zapatillas',
    description:
      'Plataforma web para la venta de zapatillas. Permite a los usuarios explorar el catálogo, agregar productos al carrito y realizar compras de manera segura y eficiente.',
    tags: ['React', 'Tailwind CSS', 'Supabase', 'PostgreSQL'],
    codeUrl: '#',
    previewUrl: '#',
    img: '/images/projects/project-4.webp',
  },
];
---

<section class="max-w-[1060px]" aria-labelledby="projects-title">
  <div class="flex items-center gap-[10px] md:gap-[14px] mb-[32px] md:mb-[60px]">
    <span class="inline-flex items-center justify-center w-[26px] h-[26px] md:w-[32px] md:h-[32px]" aria-hidden="true">
      <svg class="w-[24px] h-[24px] md:w-[30px] md:h-[30px] stroke-[var(--color-text)] stroke-2 fill-none stroke-[2.2px]" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 8 4 12l4 4" />
        <path d="M16 8l4 4-4 4" />
        <path d="m14 5-4 14" />
      </svg>
    </span>
    <h2 class="m-0 text-[1.6rem] md:text-[clamp(2rem,4vw,3.3rem)] font-extrabold leading-none" id="projects-title">Proyectos</h2>
  </div>

  <div class="grid gap-[42px] md:gap-[64px]">
    {
      projects.map((project) => (
        <article class="grid grid-cols-1 lg:grid-cols-[minmax(280px,0.95fr)_minmax(280px,1fr)] gap-[20px] md:gap-[clamp(32px,5vw,64px)] items-center group/card">
          <div class="relative grid place-items-center overflow-hidden aspect-video min-h-[180px] md:min-h-0 border border-[rgba(247,244,238,0.12)] rounded-[8px] md:rounded-[10px] transition-colors duration-180 hover:border-[var(--color-accent)] after:absolute after:inset-0 after:content-[''] after:bg-[radial-gradient(rgba(247,244,238,0.18)_1px,transparent_1px)] after:bg-[length:12px_12px] after:opacity-22 after:pointer-events-none group" aria-hidden="true">
            <img class="relative z-[1] block w-full h-full object-cover object-center scale-105 transition-all duration-260 ease-out group-hover:scale-100" src={project.img} alt={project.title} loading="lazy" />
          </div>

          <div>
            <h3 class="max-w-[560px] m-0 mb-[10px] md:mb-[16px] text-[1.25rem] md:text-[clamp(1.55rem,3vw,2.35rem)] font-semibold leading-[1.15] md:leading-[1.12]">{project.title}</h3>

            <div class="flex flex-wrap gap-[6px] md:gap-[8px] mb-[14px] md:mb-[18px]" aria-label="Tecnologías usadas">
              {project.tags.map((tag) => <span class="inline-flex items-center min-h-[22px] md:min-h-[24px] px-[8px] md:px-[10px] rounded-full bg-[rgba(255,61,18,0.13)] even:bg-[rgba(43,130,255,0.2)] text-[var(--color-text)] font-mono text-[0.68rem] md:text-[0.72rem] font-extrabold">{tag}</span>)}
            </div>

            <p class="max-w-[590px] m-0 text-[var(--color-muted)] text-[0.92rem] md:text-[clamp(1rem,1.5vw,1.17rem)] font-semibold leading-[1.48] md:leading-[1.42]">{project.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
