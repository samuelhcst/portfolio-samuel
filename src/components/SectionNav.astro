---
const sections = [
  { number: '01', label: 'Experiencia', href: '#experiencia' },
  { number: '02', label: 'Proyectos', href: '#proyectos' },
  { number: '03', label: 'Tecnologías', href: '#stack' },
  { number: '04', label: 'Sobre mí', href: '#sobre-mi' },
];
---

<aside class="hidden lg:block sticky top-10 self-start h-fit w-[250px] pointer-events-none" aria-label="Navegación por secciones">
  <nav class="grid gap-[6px] content-start pointer-events-auto">
    {
      sections.map((section, index) => (
        <a data-nav-link class:list={[
          'group grid grid-cols-[32px_1fr] items-center w-fit min-h-[28px] px-[8px] text-[var(--color-text)] font-mono text-[0.76rem] font-extrabold uppercase transition-all duration-180 ease-out',
          { 'is-active': index === 0 }
        ]} href={section.href}>
          <span class="inline-flex items-center justify-center w-[24px] min-h-[24px] font-bold transition-colors duration-180 ease-out group-hover:text-[#080808] group-hover:bg-[var(--color-accent)] group-[.is-active]:text-[#080808] group-[.is-active]:bg-[var(--color-text)] group-[.is-active]:group-hover:bg-[var(--color-accent)]">{section.number}</span>
          <strong class="font-black">{section.label}</strong>
        </a>
      ))
    }
  </nav>

  <div class="mt-[24px] w-[min(100%,230px)] min-h-[77vh] bg-[radial-gradient(rgba(247,244,238,0.52)_1px,transparent_1px)] bg-[length:10px_10px] opacity-65" aria-hidden="true"></div>
</aside>

<script>
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')
  );

  const navItems = navLinks.flatMap((link) => {
    const href = link.getAttribute('href');

    if (!href) return [];

    const section = document.querySelector<HTMLElement>(href);

    if (!section) return [];

    return [{ href, section }];
  });

  const setActiveLink = (href: string) => {
    navLinks.forEach((link) => {
      link.classList.toggle('is-active', link.getAttribute('href') === href);
    });
  };

  const updateActiveSection = () => {
    const activationPoint = window.scrollY + window.innerHeight * 0.38;
    let activeHref = navItems[0]?.href;

    navItems.forEach(({ href, section }) => {
      if (section.offsetTop <= activationPoint) {
        activeHref = href;
      }
    });

    if (activeHref) {
      setActiveLink(activeHref);
    }
  };

  let ticking = false;

  const requestActiveSectionUpdate = () => {
    if (ticking) return;

    ticking = true;

    window.requestAnimationFrame(() => {
      updateActiveSection();
      ticking = false;
    });
  };

  navLinks.forEach((link) => {
    link.addEventListener('click', () => {
      const href = link.getAttribute('href');
      if (href) setActiveLink(href);
    });
  });

  updateActiveSection();
  window.addEventListener('scroll', requestActiveSectionUpdate, { passive: true });
  window.addEventListener('resize', requestActiveSectionUpdate);
</script>
