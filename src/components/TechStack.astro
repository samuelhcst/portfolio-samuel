---
const tools = [
  { name: 'React', icon: '/logos/react_dark.svg', url: 'https://reactjs.org/' },
  { name: 'Astro', icon: '/logos/astro-icon-dark.svg', url: 'https://astro.build/' },
  { name: 'Tailwind CSS', icon: '/logos/tailwindcss.svg', url: 'https://tailwindcss.com/' },
  { name: 'TypeScript', icon: '/logos/typescript.svg', url: 'https://www.typescriptlang.org/' },
  { name: 'JavaScript', icon: '/logos/javascript.svg', url: 'https://developer.mozilla.org/en-US/docs/Web/JavaScript' },
  { name: 'Python', icon: '/logos/python.svg', url: 'https://www.python.org/' },
  { name: 'Flask', icon: '/logos/flask-dark.svg', url: 'https://flask.palletsprojects.com/' },
  { name: 'Node.js', icon: '/logos/nodejs.svg', url: 'https://nodejs.org/' },
  { name: 'Kotlin', icon: '/logos/kotlin.svg', url: 'https://kotlinlang.org/' },
  { name: 'Firebase', icon: '/logos/firebase.svg', url: 'https://firebase.google.com/' },
  { name: 'PostgreSQL', icon: '/logos/postgresql.svg', url: 'https://www.postgresql.org/' },
  { name: 'MySQL', icon: '/logos/mysql-icon-dark.svg', url: 'https://www.mysql.com/' },
  { name: 'C#', icon: '/logos/csharp.svg', url: 'https://docs.microsoft.com/en-us/dotnet/csharp/' },
  { name: 'GitHub', icon: '/logos/github_dark.svg', url: 'https://github.com/' },
  { name: 'AWS', icon: '/logos/aws_dark.svg', url: 'https://aws.amazon.com/' },
  { name: 'Azure', icon: '/logos/azure.svg', url: 'https://azure.microsoft.com/' },
];
---

<section class="max-w-[1060px]" aria-labelledby="tech-title">
  <div class="flex items-center gap-[10px] md:gap-[14px] mb-[32px] md:mb-[60px]">
    <span class="inline-flex items-center justify-center w-[26px] h-[26px] md:w-[32px] md:h-[32px]" aria-hidden="true">
      <!-- icono decorativo -->
    </span>
    <h2 class="m-0 text-[1.6rem] md:text-[clamp(2rem,4vw,3.3rem)] font-extrabold leading-none" id="tech-title">Tecnologías</h2>
  </div>

  <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-4 justify-center gap-y-[20px] gap-x-[16px] md:gap-y-[34px] md:gap-x-[36px] w-full max-w-[960px] mx-auto">
    {
      tools.map((tool) => (
        <a
          class="grid w-full max-w-[112px] justify-self-center aspect-square place-items-center border border-[rgba(247,244,238,0.06)] rounded-[16px] md:rounded-[24px] bg-[var(--color-surface)] shadow-[inset_0_1px_0_rgba(255,255,255,0.04),0_16px_36px_rgba(0,0,0,0.22)] transition-all duration-180 ease-out hover:border-[rgba(255,61,18,0.72)] hover:bg-[oklch(0.269_0_0)] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.06),0_18px_44px_rgba(255,61,18,0.12)] hover:-translate-y-[4px] focus-visible:outline-2 focus-visible:outline-[var(--color-accent)] focus-visible:outline-offset-4"
          href={tool.url}
          target="_blank"
          rel="noreferrer"
          aria-label={`Abrir sitio oficial de ${tool.name}`}
          title={tool.name}
        >
          <img class="w-[38px] h-[38px] md:w-[54px] md:h-[54px] object-contain" src={tool.icon} alt="" loading="lazy" />
        </a>
      ))
    }
  </div>
  
</section>
