---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionNav from '../components/SectionNav.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import Projects from '../components/Projects.astro';
import TechStack from '../components/TechStack.astro';
import About from '../components/About.astro';
---

<BaseLayout>
  <Hero />

  <section class="grid grid-cols-1 lg:grid-cols-[250px_minmax(0,1fr)] gap-[48px] md:gap-[clamp(40px,6vw,96px)] items-start w-[var(--container)] mx-auto pt-[42px] md:pt-[72px] pb-[80px] md:pb-[120px]" aria-label="Contenido del portfolio">
    <SectionNav />

    <div class="grid gap-[54px] md:gap-[96px]">
      <section id="experiencia" class="scroll-mt-[14px] md:scroll-mt-[32px] pt-0 md:pt-[12px] border-0 md:border-t border-[rgba(247,244,238,0.08)]">
        <ExperienceCard />
      </section>

      <section id="proyectos" class="scroll-mt-[14px] md:scroll-mt-[32px] pt-0 md:pt-[12px] border-0 md:border-t border-[rgba(247,244,238,0.08)]">
        <Projects />
      </section>

      <section id="stack" class="scroll-mt-[14px] md:scroll-mt-[32px] pt-0 md:pt-[12px] border-0 md:border-t border-[rgba(247,244,238,0.08)]">
        <TechStack />
      </section>

      <section id="sobre-mi" class="scroll-mt-[14px] md:scroll-mt-[32px] pt-0 md:pt-[12px] border-0 md:border-t border-[rgba(247,244,238,0.08)]">
        <About />
      </section>

    </div>
  </section>
</BaseLayout>
